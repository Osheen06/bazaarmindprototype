# BazaarMind Backend Environment Variables
# Copy this file to backend/.env

# Database (Required)
MONGO_URL=mongodb://localhost:27017
DB_NAME=bazaarmind

# CORS Origins (Comma-separated URLs of the frontend)
# In local development:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# In production on Render (point to your Vercel URL):
# CORS_ORIGINS=https://your-bazaarmind-app.vercel.app

# Google Gemini AI (Required for live signal interpretation & voice)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Google Places API (Optional, for discovering real-world neighborhood markets)
GOOGLE_MAPS_API_KEY=

# Cron Security Secret (Optional, for securing /api/cron/capture-snapshot)
WEBHOOK_CRON_SECRET=

# WhatsApp Cloud API (Optional, for WhatsApp bot channel)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
